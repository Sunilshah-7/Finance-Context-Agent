# Backend
AGENT_API_PUBLIC_URL=           # public HTTPS URL for the Agent API, used by Gradio

# Model service URLs
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_REASONER_MODEL=Qwen/Qwen2.5-72B-Instruct
NIM_PLANNER_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_URL=http://localhost:8002             # local embedding backend
RERANKER_URL=http://localhost:8003              # local reranker backend
INFERENCE_GATEWAY_URL=http://localhost:8080    # unified inference gateway (FastAPI proxy)
AGENT_API_URL=http://localhost:8090            # Agent API (FastAPI + LangGraph)

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RERANKER_PROVIDER=local

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fincontext_chunks

# Metadata database
SQLITE_DB_PATH=./fincontext.db

# SEC EDGAR — required, no API key needed but User-Agent is mandatory
# Format: AppName/Version contact-email@domain.com
SEC_USER_AGENT=FinContextAgent/0.1 your-email@example.com

# Application
AGENT_API_KEY=                  # strong random string, used by Gradio to authenticate with Agent API
ENVIRONMENT=development         # development | production
LOG_LEVEL=INFO
MAX_CONCURRENT_ANALYSES=5       # max concurrent analysis jobs
