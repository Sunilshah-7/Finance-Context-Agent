# Inference backend — choose one: local vLLM or NVIDIA NIM
#
# Option A: local vLLM (AMD MI300X via ROCm, or any CUDA GPU)
#   Leave NIM_API_KEY empty. Set the vLLM URLs below.
#
# Option B: NVIDIA NIM hosted inference (no GPU required)
#   Set NIM_API_KEY. The gateway switches to NIM automatically.
#   Get a free API key at https://build.nvidia.com

# NVIDIA NIM (leave blank to use local vLLM instead)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_REASONER_MODEL=Qwen/Qwen2.5-72B-Instruct
NIM_PLANNER_MODEL=Qwen/Qwen2.5-14B-Instruct

# Local vLLM URLs (used when NIM_API_KEY is not set)
VLLM_REASONER_URL=http://localhost:8000/v1      # Qwen2.5-72B-Instruct
VLLM_PLANNER_URL=http://localhost:8001/v1       # Qwen2.5-14B-Instruct

# vLLM model identifiers (used in docker compose and vLLM startup args)
VLLM_REASONER_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
VLLM_REASONER_SERVED_NAME=fincontext-reasoner
VLLM_REASONER_MAX_MODEL_LEN=65536
VLLM_REASONER_GPU_UTILIZATION=0.85
VLLM_REASONER_TENSOR_PARALLEL=1

VLLM_PLANNER_MODEL_ID=Qwen/Qwen2.5-14B-Instruct
VLLM_PLANNER_SERVED_NAME=fincontext-planner
VLLM_PLANNER_MAX_MODEL_LEN=16384
VLLM_PLANNER_GPU_UTILIZATION=0.16
VLLM_PLANNER_TENSOR_PARALLEL=1

# Embedding and reranking (always local TEI, both backends)
EMBEDDING_URL=http://localhost:8002             # BAAI/bge-large-en-v1.5 (TEI)
RERANKER_URL=http://localhost:8003              # BAAI/bge-reranker-large (TEI)
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
RERANKER_MODEL_ID=BAAI/bge-reranker-large

# Gateway and Agent API
INFERENCE_GATEWAY_URL=http://localhost:8080    # unified inference gateway (FastAPI proxy)
AGENT_API_URL=http://localhost:8090            # Agent API (FastAPI + LangGraph)
AGENT_API_PUBLIC_URL=                          # public HTTPS URL for the Agent API (used by React demo UI)

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fincontext_chunks

# Metadata database
SQLITE_DB_PATH=./fincontext.db

# HuggingFace — required for model download from HF Hub (local vLLM path only)
HF_TOKEN=                       # your HuggingFace access token (hf_...)
HF_HOME=/models/huggingface     # model cache directory on AMD VM — must have enough disk space

# SEC EDGAR — required, no API key needed but User-Agent is mandatory
# Format: AppName/Version contact-email@domain.com
SEC_USER_AGENT=FinContextAgent/0.1 your-email@example.com

# Application
AGENT_API_KEY=                  # strong random string; if set, Agent API requires Bearer <key> on write endpoints
ENVIRONMENT=development         # development | production
LOG_LEVEL=INFO
MAX_CONCURRENT_ANALYSES=5       # max concurrent analysis jobs

# Docker model cache (for docker compose volume mount, local vLLM path only)
MODEL_CACHE_DIR=/models         # host path for persistent model storage
