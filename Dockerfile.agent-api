FROM node:20-bookworm AS ui
WORKDIR /app/apps/demo-ui
COPY apps/demo-ui/package*.json ./
RUN npm install
COPY apps/demo-ui/ ./
RUN npm run build

FROM golang:1.25-bookworm AS build
ENV GOCACHE=/tmp/go-build-cache
ENV GOMODCACHE=/tmp/go-mod-cache
WORKDIR /app
COPY backend/go.mod backend/go.sum* ./backend/
WORKDIR /app/backend
RUN go mod download
WORKDIR /app
COPY backend/ ./backend/
RUN mkdir -p /app/bin && cd backend && CGO_ENABLED=0 GOOS=linux go build -o /app/bin/agent-api ./cmd/agent-api && test -x /app/bin/agent-api

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /app/bin/agent-api /app/agent-api
COPY --from=ui /app/apps/demo-ui/out /app/public
COPY data/fixtures /app/data/fixtures
ENV PORT=8090
ENV FIXTURE_DIR=/app/data/fixtures
ENV STATIC_DIR=/app/public
ENV SQLITE_DB_PATH=/app/state/fincontext.db
EXPOSE 8090
ENTRYPOINT ["/app/agent-api"]
