FROM golang:1.25.1-bookworm AS build
ENV GOCACHE=/tmp/go-build-cache
ENV GOMODCACHE=/tmp/go-mod-cache
WORKDIR /app
COPY backend/go.mod backend/go.sum* ./backend/
WORKDIR /app/backend
RUN go mod download
WORKDIR /app
COPY backend/ ./backend/
RUN set -eux; \
    mkdir -p /app/bin; \
    cd backend; \
    go env GOCACHE GOMODCACHE GOOS GOARCH; \
    CGO_ENABLED=0 GOOS=linux go build -v -o inference-gateway ./cmd/inference-gateway; \
    cp inference-gateway /app/bin/inference-gateway; \
    ls -l /app/bin/inference-gateway

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /app/bin/inference-gateway /app/inference-gateway
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/inference-gateway"]
