FROM golang:1.25-bookworm AS build
ENV GOCACHE=/tmp/go-build-cache
ENV GOMODCACHE=/tmp/go-mod-cache
WORKDIR /app
COPY backend/go.mod backend/go.sum* ./backend/
WORKDIR /app/backend
RUN go mod download
WORKDIR /app
COPY backend/ ./backend/
RUN mkdir -p /app/bin && cd backend && CGO_ENABLED=0 GOOS=linux go build -o /app/bin/inference-gateway ./cmd/inference-gateway && test -x /app/bin/inference-gateway

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /app/bin/inference-gateway /app/inference-gateway
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/inference-gateway"]
